    "@azure/monitor-opentelemetry": "1.20.1",
    "@azure/search-documents": "13.0.0",
    "@azure/storage-blob": "12.34.0",
    "@azure/storage-queue": "12.32.0",
    "@fastify/multipart": "10.1.6",
    "@fastify/static": "10.1.10",
    "fastify": "5.12.7",
    "openai": "7.43.0",
    "unpdf": "1.6.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "5.8.3"
