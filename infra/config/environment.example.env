# GeoBasin Explorer AI deployment settings.
# Copy this file to infra/config/environment.env (git ignores it), fill it in, and run infra/scripts/deploy.sh.
# Values the deployment discovers as it goes (the sign-in app ID, the Fabric item IDs, the agents' identities) are written
# to infra/config/environment.generated.env, which git also ignores. docs/DEPLOYMENT.md explains every step.

# ---- Infrastructure as code ----------------------------------------------------------------------------------------
# bicep (infra/bicep, deployed by infra/scripts/deploy.sh) or terraform (infra/terraform, applied by you; the scripts then
# read its outputs for the Entra, Fabric and hosted-agent steps).
GBX_IAC=bicep

# ---- Tenant and subscriptions -----------------------------------------------------------------------------------------
# The Microsoft Entra tenant and the subscription for the platform (greenfield: an empty subscription; brownfield: any
# subscription where you may create the rg-geobasin-* resource groups).
GBX_TENANT_ID=
GBX_SUBSCRIPTION_ID=
# Optional second subscription for the version 2 Foundry account (hosted agents and the model router), when the first
# lacks Data Zone quota for the models. Empty uses GBX_SUBSCRIPTION_ID.
GBX_AGENTS_SUBSCRIPTION_ID=

# ---- Regions ------------------------------------------------------------------------------------------------------------
# A region that offers Azure AI Foundry hosted agents, the model router on Data Zone Standard, Azure AI Search, Document
# Intelligence, Container Apps and Microsoft Fabric. West US 3 was used to build and test this solution.
GBX_LOCATION=westus3
# Azure Maps is offered in fewer regions; West US 2 pairs with West US 3 inside the United States geography.
GBX_MAPS_LOCATION=westus2

# ---- People -------------------------------------------------------------------------------------------------------------
# Object ID of the operator (you, or the pipeline's service principal): az ad signed-in-user show --query id -o tsv
GBX_OPERATOR_OBJECT_ID=
# Email for budget and service alerts.
GBX_ALERT_EMAIL=
# Users or groups (object IDs, comma-separated) who may sign in, and those who also hold GeoBasin.Owner (publish uploads,
# approve live-lane extractions, roll back expert reviews). Empty assigns only the operator.
GBX_SIGNIN_PRINCIPALS=
GBX_OWNER_PRINCIPALS=
# Fabric capacity administrators: user principal names for people, object IDs for service principals, comma-separated.
GBX_FABRIC_ADMINS=

# ---- Public address -----------------------------------------------------------------------------------------------------
# An Azure DNS zone in rg-geobasin-edge that you control (delegate it from your registrar or parent zone first), and the
# host people use. Front Door serves the host and redirects the zone apex to it.
GBX_DNS_ZONE=
GBX_SITE_HOST=
GBX_SITE_URL=
# Other browser origins allowed to use Azure Maps (comma-separated), for example a test host.
GBX_ADDITIONAL_ORIGINS=
# false until both domains validate and the Private Link connection is approved (docs/DEPLOYMENT.md, Edge).
GBX_EDGE_CUTOVER=false

# ---- Cost guardrails ----------------------------------------------------------------------------------------------------
GBX_BUDGET_AMOUNT=1500
GBX_AGENTS_BUDGET_AMOUNT=300
# yyyy-MM-01; empty uses the current month.
GBX_BUDGET_START_DATE=
GBX_OWNER_TAG=platform-team

# ---- Application behaviour ----------------------------------------------------------------------------------------------
# Brand pack in app/src/brand (geobasin, or one you add).
GBX_BRAND=geobasin
GBX_SITE_APP_NAME="GeoBasin Explorer AI"
# Kill switch for every model call.
GBX_AI_ENABLED=true
# Microsoft Defender for Storage malware scanning on upload; uploads are refused while it is off.
GBX_MALWARE_SCAN=true
# ClamAV verdict before the live lane reads a fetched source file (infra/bicep/pipeline.bicep runs the scanner).
GBX_LIVE_SCAN=true
GBX_PURVIEW=false
GBX_QUESTIONS_PER_DAY=5000
GBX_TOKENS_PER_DAY=50000000
# Document Intelligence pages the live lane may read in a day. The full public library is about 1,850 pages, so the default
# loads it over four days; 2000, the most infra/bicep/live.bicep allows, loads it in one.
GBX_OCR_PAGES_PER_DAY=500

# ---- Live ingestion lane (Document Intelligence and Azure AI Search) -----------------------------------------------------
# The public sources the live lane fetches, reads and indexes (ids from services/api/src/live/pipeline-registry.ts; every
# one is in data/sources/manifest.csv or the registry's eCat records). deploy.sh content lands each one.
GBX_LIVE_SOURCES=ga-147461,peps-sa-marabooka-1,ga-147459,ga-147460,ga-147462,peps-sa-habanero-1,ga-144233,ga-133023-points,ga-145744,ga-147688,ga-146380,ga-81486,ga-ecat-133023,ga-ecat-145744,ga-ecat-147688,ga-ecat-148588,ga-ecat-67240,ga-ecat-65388,ga-ecat-126310,ga-ecat-100520,ga-74123-userguide,ga-74123-inversion,ga-74123-fugro,ga-74123-metadata,ga-ecat-74123,ga-ecat-65384,ga-ecat-84308,ga-132709,ga-ecat-132709,ga-149375,ga-ecat-149375,ga-145984-report,ga-ecat-145984,ga-ecat-144778,ga-ecat-144775,ga-ecat-144783,ga-144414,ga-ecat-144414,ga-67212-fugro,ga-ecat-67212,ga-68792-userguide,ga-ecat-68792,ga-67211-report,ga-ecat-67211,ga-74137-userguide,ga-74137-inversion,ga-ecat-74137,ga-69470,ga-ecat-69470,ga-69190,ga-ecat-69190,ga-70711,ga-ecat-70711,ga-65704,ga-ecat-65704,ga-ecat-65395,ga-ecat-65231,ga-ecat-140140,ga-ecat-140141,ga-ecat-75582,ga-112283-metadata,ga-ecat-112283,ga-ecat-123889,ga-116461,ga-ecat-116461,ga-ecat-114642,linz-s25000,linz-s25002,linz-s25009,linz-g25700,linz-g25702,linz-g25703,linz-itrf-nzgd2000,icsm-gda2020-manual,nzpam-basins-part-one,nzpam-basins-part-two,linz-hannah-2001
# matched: only questions whose best library matches include a live source; all: every question the prepared rules don't cover.
GBX_LIVE_ROUTE=all
# The published serving agent (services/api/scripts/agent-release.ts prints both). Empty keeps the packaged answers.
GBX_LIVE_AGENT_NAME=
GBX_LIVE_AGENT_VERSION=

# ---- Microsoft Fabric (knowledge ontology, graph and Fabric IQ) ----------------------------------------------------------
# false deploys everything else without Fabric: no ontology, graph, Fabric IQ or OneLake library, and the scientists answer
# from the library's passages. Fabric needs a capacity administrator who is a member of this tenant (B2B guests can't be).
GBX_FABRIC_ENABLED=true
# true creates a capacity (infra/bicep/agents/fabric-capacity.bicep); false uses one you already own (brownfield).
GBX_FABRIC_CAPACITY_CREATE=true
# 3 to 63 lower-case letters and digits, starting with a letter.
GBX_FABRIC_CAPACITY_NAME=
GBX_FABRIC_CAPACITY_RESOURCE_GROUP=rg-geobasin-fabric
GBX_FABRIC_CAPACITY_SKU=F8
# The workspace that holds the lakehouse, ontology and graph. deploy.sh fabric creates it on the capacity when no
# workspace of that name exists, and records its ID; brownfield deployments may set GBX_FABRIC_WORKSPACE_ID instead.
GBX_FABRIC_WORKSPACE_NAME="GeoBasin Knowledge"
GBX_FABRIC_WORKSPACE_ID=
# true deploys the morning job that resumes a capacity your organisation pauses overnight (fabric-resume.bicep).
GBX_FABRIC_RESUME=false
GBX_FABRIC_RESUME_TIME_ZONE=UTC
GBX_FABRIC_RESUME_HOUR=6

# ---- Optional ----------------------------------------------------------------------------------------------------------
# Public address ranges (CIDR, comma-separated) admitted to the agent data while you verify the Foundry setup.
GBX_OPERATOR_CIDRS=
# true adds the geo phase to deploy.sh all: the GeoCatalog (Planetary Computer Pro) and its Copernicus data for the map's
# overlays (infra/bicep/geo.bicep, in GBX_GEO_LOCATION, northcentralus by default, because GeoCatalogs aren't offered in
# every region).
GBX_DEPLOY_GEO=false
# true adds the governance phase: a Microsoft Purview account (infra/bicep/governance.bicep, in GBX_GOVERNANCE_LOCATION,
# westus by default). The first Purview account in a tenant becomes its enterprise account, which bills governed assets.
GBX_DEPLOY_GOVERNANCE=false
# The live lane's Purview lineage, once id-gbx-pipeline holds Data Curator on the collection named here.
# GBX_PURVIEW_COLLECTION_ID=
# The platform Foundry account's deployments in thousands of tokens a minute (100, 100 and 300 by default).
# GBX_ANSWER_CAPACITY=100
# GBX_VALIDATOR_CAPACITY=100
# GBX_EMBED_CAPACITY=300
# The World Stress Map Database Release 2025 (https://doi.org/10.5880/WSM.2025.001), downloaded by hand, for the knowledge
# graph's stress records; a path relative to the repository root (ingestion-framework/docs/KNOWLEDGE_INPUTS.md).
# GBX_WSM_CSV=build/downloads/WSM_Database_2025.csv
# Lifetime in days of the sign-in layer's client secret; a tenant's app management policy may allow less, and then the
# site phase uses the longest lifetime it accepts and says when to redeploy.
# GBX_SITE_SECRET_DAYS=180
# How many public sources deploy.sh content lands at once inside the virtual network.
# GBX_CONTENT_PARALLEL=4
# What-if instead of deploying, for every template step.
GBX_WHATIF=
